[includeIf "gitdir:~/work/**"]
  path = ~/.gitconfig-work
[includeIf "gitdir:~/work/phare/**"]
  path = ~/.gitconfig-work
[includeIf "gitdir:~/work/palantir/**"]
  path = ~/.gitconfig-palantir
[includeIf "gitdir:~/personal/**"]
  path = ~/.gitconfig-codeberg
[includeIf "gitdir:~/.config/**"]
  path = ~/.gitconfig-codeberg

[commit]
  gpgsign = true

[tag]
  forceSignAnnotated = false

[rerere]
  enabled = true

[safe]
  directory = ~/.local/share/nvim/lazy/fidget.nvim
  directory = ~/.local/share/nvim/lazy/mason-lspconfig.nvim

[init]
  defaultBranch = main

[core]
  symlinks = true

[alias]
  # Note: These aliases reference environment variables for security.
  # Set in your shell or git config:
  #   export GIT_PERSONAL_EMAIL="your@email.com"
  #   export GIT_PERSONAL_KEY="YOUR_KEY_ID"
  #   export GIT_CODEBERG_EMAIL="your@codeberg.email"
  #   export GIT_CODEBERG_KEY="YOUR_KEY_ID"

  # Push to GitHub with personal identity
  push-github = "!f() { \
      if [ -z \"$GIT_PERSONAL_EMAIL\" ] || [ -z \"$GIT_PERSONAL_KEY\" ]; then \
          echo \"Error: Set GIT_PERSONAL_EMAIL and GIT_PERSONAL_KEY environment variables\"; \
          return 1; \
      fi; \
      git config user.email \"$GIT_PERSONAL_EMAIL\" && \
      git config user.signingkey \"$GIT_PERSONAL_KEY\" && \
      git push origin \"$@\"; \
  }; f"

  # Push to Codeberg with codeberg identity
  push-codeberg = "!f() { \
      if [ -z \"$GIT_CODEBERG_EMAIL\" ] || [ -z \"$GIT_CODEBERG_KEY\" ]; then \
          echo \"Error: Set GIT_CODEBERG_EMAIL and GIT_CODEBERG_KEY environment variables\"; \
          return 1; \
      fi; \
      git config user.email \"$GIT_CODEBERG_EMAIL\" && \
      git config user.signingkey \"$GIT_CODEBERG_KEY\" && \
      git push codeberg \"$@\"; \
  }; f"

  # Push to both
  push-all = "!git push-github && git push-codeberg"

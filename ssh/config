Include /Users/chmc-h022fl97xj/.colima/ssh_config

Include ~/.config/colima/ssh_config

# ~/.ssh/config

# Personal GitHub account
Host github-personal
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_personal
    IdentitiesOnly yes

# Personal Codeberg account
Host github-codeberg
    HostName codeberg.org
    User git
    IdentityFile ~/.ssh/id_proton
    IdentitiesOnly yes

# Work GitHub account
Host github-work
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_work
    IdentitiesOnly yes

# Default GitHub (fallback)
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_work
    IdentitiesOnly yes


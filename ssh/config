Include ~/.config/colima/ssh_config

# ~/.ssh/config

# Personal GitHub account
Host github-personal
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_personal
    IdentitiesOnly yes

# Personal GitHub account
Host github-codeberg
    HostName codeberg.org
    User git
    IdentityFile ~/.ssh/id_proton
    IdentitiesOnly yes

# Work GitHub account
Host github-work
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_work
    IdentitiesOnly yes

# Phare GitHub account
Host github-phare
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_phare_rsa
    IdentitiesOnly yes

# Default GitHub (fallback)
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_work
    IdentitiesOnly yes


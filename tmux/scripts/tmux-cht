#!/usr/bin/env bash
set -euo pipefail

dir=~/.config/tmux
selected=$(cat "$dir/.tmux-cht-languages" "$dir/.tmux-cht-command" | fzf) || exit 0
[[ -z "$selected" ]] && exit 0

read -rp "Enter Query: " query
query=${query// /+}

if grep -qxF "$selected" "$dir/.tmux-cht-languages"; then
    url="cht.sh/$selected${query:+/$query}"
else
    url="cht.sh/$selected${query:+~$query}"
fi

curl -s "$url" | less -R

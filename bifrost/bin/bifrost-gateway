#!/usr/bin/env bash
# Manage the local Bifrost gateway (launchd) and the launcher's link to it.
# See bifrost/README.md for how the pieces fit together.
# shellcheck disable=SC2015  # `check && pass || fail`: pass never fails
set -euo pipefail

SELF="$(realpath "${BASH_SOURCE[0]}")"
PKG_DIR="$(dirname "$(dirname "$SELF")")"
APP_DIR="${BIFROST_APP_DIR:-$HOME/.config/bifrost}"
HOST=127.0.0.1
PORT="${BIFROST_PORT:-8080}"
URL="http://localhost:$PORT"
LABEL=ai.getbifrost.gateway
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG_DIR="$HOME/Library/Logs"
STARTED_MARKER="$APP_DIR/.gateway-started"
CLI_CONFIG="$HOME/.bifrost/config.json"
LAUNCHER="$HOME/.bifrost/bin/bifrost"
CLI_CONTEXT=local
UPSTREAM=https://bifrost.r1rcm.com
VERSION="${BIFROST_VERSION:-$(<"$PKG_DIR/gateway.version")}"
ARCH=$([[ $(uname -m) == arm64 ]] && echo arm64 || echo amd64)
bin_path() { echo "$HOME/Library/Caches/bifrost/$1/bin/bifrost-http-0"; }

# keychain service suffix : env var : required|optional : generated locally
SECRETS=(
	r1rcm-vk:BIFROST_R1RCM_VK:req:no
	setup-token:BIFROST_SETUP_TOKEN:req:yes
	vk-opencode:BIFROST_VK_OPENCODE:req:yes
	vk-claude:BIFROST_VK_CLAUDE:req:yes
	vk-codex:BIFROST_VK_CODEX:req:yes
	vk-scripts:BIFROST_VK_SCRIPTS:req:yes
)

secret() { security find-generic-password -s "bifrost-$1" -a "$USER" -w 2>/dev/null; }
has_secret() { security find-generic-password -s "bifrost-$1" -a "$USER" >/dev/null 2>&1; }
store_secret() { security add-generic-password -U -s "bifrost-$1" -a "$USER" -w "$2"; }

if [[ -t 1 ]]; then
	OK=$'\e[32m✓\e[0m' BAD=$'\e[31m✗\e[0m' WARN=$'\e[33m!\e[0m' DIM=$'\e[2m' BOLD=$'\e[1m' RST=$'\e[0m'
else
	OK='ok' BAD='FAIL' WARN='warn' DIM='' BOLD='' RST=''
fi

usage() {
	cat <<EOF
${BOLD}bifrost-gateway${RST} (alias: bfgw) - local Bifrost gateway on $URL

  up                 start or repair everything, copy setup token
  down               stop the gateway
  dash               copy setup token and open the dashboard
  status             running state, health, version
  logs [-f]          gateway logs
  doctor [--fix]     check everything; --fix repairs what it can

  start | stop | restart
  secrets [list | --generate | set <name>]
  secret <name>      print a keychain secret
  upgrade [version]  install a release, pin it, restart
  install [version]  download a release without pinning
  cli-sync           point the bifrost launcher at this gateway
  setup              same as up (used by setup.sh)
EOF
}

http_code() { curl -s -o /dev/null -w '%{http_code}' --max-time 8 "$@" || true; }
healthy() { [[ $(http_code --max-time 2 "http://$HOST:$PORT/health") == 200 ]]; }
is_loaded() { launchctl print "gui/$UID/$LABEL" >/dev/null 2>&1; }
running_pid() { launchctl print "gui/$UID/$LABEL" 2>/dev/null | awk '$1 == "pid" {print $3; exit}'; }

load_secrets() {
	local missing=() name var need _
	for s in "${SECRETS[@]}"; do
		IFS=: read -r name var need _ <<<"$s"
		if v=$(secret "$name"); then
			export "$var=$v"
		elif [[ $need == req ]]; then missing+=("bifrost-$name"); fi
	done
	if ((${#missing[@]})); then
		echo "missing keychain items: ${missing[*]} -- run: bifrost-gateway secrets" >&2
		exit 0 # clean exit so launchd's KeepAlive doesn't loop
	fi
}

install() {
	local ver="${1:-$VERSION}" dest
	dest=$(bin_path "$ver")
	[[ -x $dest ]] && return
	echo "downloading bifrost-http $ver"
	mkdir -p "$(dirname "$dest")"
	curl -fL --progress-bar -o "$dest.tmp" \
		"https://downloads.getmaxim.ai/bifrost/$ver/darwin/$ARCH/bifrost-http"
	chmod +x "$dest.tmp" && mv "$dest.tmp" "$dest"
}

run() {
	load_secrets
	install
	if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null; then
		echo "port $PORT busy" >&2
		exit 1
	fi
	# local stdio MCP servers (uvx, npx) need mise shims
	export PATH="$HOME/.local/share/mise/shims:/opt/homebrew/bin:$PATH"
	cd "$APP_DIR"
	touch "$STARTED_MARKER"
	exec "$(bin_path "$VERSION")" -app-dir "$APP_DIR" -host "$HOST" -port "$PORT" \
		-log-level "${BIFROST_LOG_LEVEL:-info}" -log-style json
}

# The launcher regenerates its config.json from the current context (state.json)
# and keeps virtual keys in the keychain, so point it at the local gateway through
# its own CLI. The upstream "default" context stays available via --context default.
cli_sync() {
	local model vk existing='{}' tmp
	[[ -x $LAUNCHER ]] || {
		echo "$WARN launcher not installed at $LAUNCHER; skipping cli-sync" >&2
		return 0
	}
	model=$(jq -r '.default_model // ""' "$PKG_DIR/cli.json")

	if ! "$LAUNCHER" context show "$CLI_CONTEXT" >/dev/null 2>&1; then
		"$LAUNCHER" context add "$CLI_CONTEXT" --base-url "$URL" ${model:+--default-model "$model"} >/dev/null
	fi
	"$LAUNCHER" context use "$CLI_CONTEXT" >/dev/null
	[[ -n $model ]] && "$LAUNCHER" config set default-model "$model" >/dev/null
	if vk=$(secret vk-opencode); then
		"$LAUNCHER" --context "$CLI_CONTEXT" auth set-virtual-key --stdin <<<"$vk" >/dev/null
	else
		echo "$WARN bifrost-vk-opencode missing; launcher has no key for $CLI_CONTEXT" >&2
	fi

	# Remaining launcher preferences (harness, auto install/attach) live in config.json
	mkdir -p "$(dirname "$CLI_CONFIG")"
	[[ -f $CLI_CONFIG ]] && existing=$(<"$CLI_CONFIG")
	tmp=$(mktemp "$CLI_CONFIG.XXXXXX")
	jq -n --argjson cur "$existing" --slurpfile want "$PKG_DIR/cli.json" '$cur * $want[0]' >"$tmp"
	chmod 600 "$tmp"
	rm -f "$CLI_CONFIG"
	mv "$tmp" "$CLI_CONFIG"
	echo "$OK launcher using context '$CLI_CONTEXT' ($URL)"
}

link_files() {
	mkdir -p "$HOME/.local/bin" "$HOME/.config/fish/completions"
	ln -sf "$SELF" "$HOME/.local/bin/bifrost-gateway"
	ln -sf "$PKG_DIR/completions/bifrost-gateway.fish" "$HOME/.config/fish/completions/bifrost-gateway.fish"
}

render_plist() { sed "s|__HOME__|$HOME|g" "$PKG_DIR/launchd/$LABEL.plist"; }
plist_current() { [[ -f $PLIST ]] && diff -q <(render_plist) "$PLIST" >/dev/null; }

# Install or refresh the plist; an outdated plist is unloaded so the next start picks it up.
ensure_plist() {
	plist_current && return
	mkdir -p "$(dirname "$PLIST")"
	if is_loaded; then launchctl bootout "gui/$UID/$LABEL" 2>/dev/null || true; fi
	render_plist >"$PLIST"
	echo "$OK installed $PLIST"
}

wait_healthy() {
	local _
	for _ in {1..40}; do
		healthy && return 0
		sleep 0.5
	done
	echo "$BAD gateway did not become healthy on :$PORT; last errors:" >&2
	tail -n 15 "$LOG_DIR/bifrost-gateway.err.log" >&2 2>/dev/null || true
	return 1
}

config_changed() {
	[[ ! -f $STARTED_MARKER ]] || [[ $APP_DIR/config.json -nt $STARTED_MARKER ]] ||
		[[ $PKG_DIR/gateway.version -nt $STARTED_MARKER ]]
}

start_service() {
	ensure_plist
	if ! is_loaded; then
		launchctl bootstrap "gui/$UID" "$PLIST"
		echo "$OK started $LABEL"
	elif ! healthy; then
		launchctl kickstart -k "gui/$UID/$LABEL"
		echo "$OK restarted $LABEL"
	fi
	wait_healthy
}

restart_service() {
	ensure_plist
	if is_loaded; then
		launchctl kickstart -k "gui/$UID/$LABEL"
	else
		launchctl bootstrap "gui/$UID" "$PLIST"
	fi
	echo "$OK restarted $LABEL"
	wait_healthy
}

stop_service() {
	local _
	if is_loaded; then
		launchctl bootout "gui/$UID/$LABEL"
		# bootout returns before launchd finishes tearing the job down
		for _ in {1..20}; do
			is_loaded || break
			sleep 0.5
		done
		echo "$OK stopped $LABEL"
	else
		echo "$DIM$LABEL not running$RST"
	fi
}

copy_token() {
	local token
	if token=$(secret setup-token) && command -v pbcopy >/dev/null; then
		printf '%s' "$token" | pbcopy
		echo "$OK setup token copied to clipboard"
	fi
}

status() {
	local pid
	if is_loaded; then
		pid=$(running_pid)
		if healthy; then
			echo "$OK running ${DIM}pid ${pid:-?}, $VERSION, $URL$RST"
		else
			echo "$WARN loaded but not healthy ${DIM}pid ${pid:-none}$RST (bfgw logs)"
		fi
	else
		echo "$BAD stopped$RST (bfgw up)"
	fi
}

secrets_list() {
	local name var need gen incomplete=0
	for s in "${SECRETS[@]}"; do
		IFS=: read -r name var need gen <<<"$s"
		if has_secret "$name"; then
			printf '%s %-24s %s%s%s\n' "$OK" "bifrost-$name" "$DIM" "$var" "$RST"
		else
			[[ $need == req ]] && incomplete=1
			printf '%s %-24s %s%s (%s)%s\n' "$([[ $need == req ]] && echo "$BAD" || echo "$WARN")" \
				"bifrost-$name" "$DIM" "$var" "$([[ $need == req ]] && echo required || echo optional)" "$RST"
		fi
	done
	if ((incomplete)); then
		echo
		echo "Fix with:"
		has_secret r1rcm-vk || echo "  bifrost-gateway secrets set r1rcm-vk   # paste your r1rcm virtual key"
		echo "  bifrost-gateway secrets --generate      # create missing local keys and setup token"
	fi
	return "$incomplete"
}

secrets_generate() {
	local name var need gen
	for s in "${SECRETS[@]}"; do
		IFS=: read -r name var need gen <<<"$s"
		[[ $gen == yes ]] || continue
		has_secret "$name" && continue
		if [[ $name == vk-* ]]; then
			store_secret "$name" "sk-bf-$(openssl rand -hex 24)"
		else
			store_secret "$name" "$(openssl rand -hex 32)"
		fi
		echo "$OK generated bifrost-$name"
	done
}

secrets_set() {
	local name="${1:?usage: bifrost-gateway secrets set <name>}" value
	read -rsp "value for bifrost-$name: " value
	echo
	[[ -n $value ]] || {
		echo "empty value, nothing stored" >&2
		exit 1
	}
	store_secret "$name" "$value"
	echo "$OK stored bifrost-$name"
}

# Prompt for the upstream key when interactive, generate everything local.
ensure_secrets() {
	if ! has_secret r1rcm-vk; then
		if [[ -t 0 ]]; then
			echo "The r1rcm virtual key is not in the keychain yet."
			secrets_set r1rcm-vk
		else
			echo "$BAD bifrost-r1rcm-vk missing; run: bifrost-gateway secrets set r1rcm-vk" >&2
			return 1
		fi
	fi
	secrets_generate
}

secrets_cmd() {
	case "${1:-list}" in
	list) secrets_list ;;
	--generate | generate) secrets_generate ;;
	set) secrets_set "${2:-}" ;;
	*)
		echo "usage: bifrost-gateway secrets [list|--generate|set <name>]" >&2
		exit 2
		;;
	esac
}

doctor() {
	local fix=0 quiet=0 fails=0 warns=0 fixes=() arg
	for arg in "$@"; do
		case "$arg" in
		--fix) fix=1 ;;
		--quiet | -q) quiet=1 ;;
		*)
			echo "usage: bifrost-gateway doctor [--fix] [--quiet]" >&2
			return 2
			;;
		esac
	done

	section() { ((quiet)) || printf '\n%s\n' "$1"; }
	pass() { ((quiet)) || echo "$OK $1"; }
	fail() {
		echo "$BAD $1"
		fails=$((fails + 1))
		[[ -n ${2:-} ]] && fixes+=("$2")
	}
	warn() {
		echo "$WARN $1"
		warns=$((warns + 1))
		[[ -n ${2:-} ]] && fixes+=("$2")
	}

	section "tools"
	for t in curl jq lsof openssl security uvx; do
		command -v "$t" >/dev/null && pass "$t" || fail "$t not found"
	done

	section "secrets"
	local name var need _
	for s in "${SECRETS[@]}"; do
		IFS=: read -r name var need _ <<<"$s"
		if has_secret "$name"; then pass "bifrost-$name"
		elif [[ $need == req ]]; then fail "bifrost-$name missing (bfgw secrets)" secrets
		else warn "bifrost-$name missing (optional)"; fi
	done

	section "config"
	local cfg="$APP_DIR/config.json"
	if jq -e . "$cfg" >/dev/null 2>&1; then
		pass "$cfg is valid JSON"
		local known ref
		known=$(printf '%s\n' "${SECRETS[@]}" | cut -d: -f2)
		while read -r ref; do
			[[ -z $ref ]] && continue
			grep -qx "$ref" <<<"$known" && pass "env.$ref backed by keychain" || fail "env.$ref has no keychain entry in SECRETS"
		done < <(grep -oE '"env\.[A-Z0-9_]+"' "$cfg" | tr -d '"' | sed 's/^env\.//' | sort -u)
	else
		fail "$cfg missing or invalid JSON"
	fi

	section "binary"
	if [[ -x $(bin_path "$VERSION") ]]; then pass "bifrost-http $VERSION cached"; else fail "bifrost-http $VERSION not cached" install; fi
	local latest
	latest=$(curl -fsS --max-time 5 https://getbifrost.ai/latest-release 2>/dev/null | jq -r .name 2>/dev/null || true)
	if [[ -n $latest && $latest != "$VERSION" ]]; then warn "newer release $latest available (bfgw upgrade)"; fi

	section "launchd"
	plist_current && pass "plist up to date" || fail "plist missing or outdated" service
	if is_loaded; then pass "$LABEL loaded"; else fail "$LABEL not loaded" service; fi
	if healthy; then pass "gateway healthy on :$PORT"; else fail "gateway not answering on :$PORT (bfgw logs)" service; fi
	if is_loaded && config_changed; then warn "config changed since the gateway started" restart; fi

	section "upstream"
	if [[ $(http_code "$UPSTREAM/health") == 200 ]]; then pass "$UPSTREAM reachable"; else fail "$UPSTREAM unreachable"; fi
	local vk
	if vk=$(secret r1rcm-vk); then
		[[ $(http_code -H "Authorization: Bearer $vk" "$UPSTREAM/v1/models") == 200 ]] &&
			pass "r1rcm key accepted (openai route)" || fail "r1rcm key rejected on /v1/models"
		[[ $(http_code -H "x-api-key: $vk" -H "anthropic-version: 2023-06-01" "$UPSTREAM/anthropic/v1/models") == 200 ]] &&
			pass "r1rcm key accepted via x-api-key (anthropic route)" ||
			warn "r1rcm rejects x-api-key on /anthropic; add network_config.extra_headers x-bf-vk"
	fi

	section "local auth"
	if healthy && vk=$(secret vk-opencode); then
		[[ $(http_code -H "Authorization: Bearer $vk" "http://$HOST:$PORT/v1/models") == 200 ]] &&
			pass "vk-opencode accepted by local gateway" || fail "vk-opencode rejected by local gateway" restart
	fi

	section "launcher"
	if [[ ! -x $LAUNCHER ]]; then
		warn "launcher not installed at $LAUNCHER"
	else
		local ctx base
		ctx=$("$LAUNCHER" config get context 2>/dev/null || true)
		base=$("$LAUNCHER" config get base-url 2>/dev/null || true)
		[[ $ctx == "$CLI_CONTEXT" ]] && pass "launcher context is '$CLI_CONTEXT'" || warn "launcher context is '$ctx'" cli-sync
		[[ $base == "$URL" ]] && pass "launcher points at local gateway" || warn "launcher base_url is $base" cli-sync
		[[ $("$LAUNCHER" --context "$CLI_CONTEXT" --output json auth status 2>/dev/null | jq -r '.has_virtual_key // false') == true ]] &&
			pass "launcher has a virtual key for '$CLI_CONTEXT'" || fail "launcher has no virtual key for '$CLI_CONTEXT'" cli-sync
	fi

	if ((!quiet || fails || warns)); then
		printf '\n%s failed, %s warnings\n' "$fails" "$warns"
	fi

	if ((fix && ${#fixes[@]})); then
		local f done=" "
		echo
		echo "fixing..."
		for f in secrets install cli-sync service restart; do
			[[ " ${fixes[*]} " == *" $f "* ]] || continue
			case "$f" in
			secrets) ensure_secrets ;;
			install) install ;;
			cli-sync) cli_sync ;;
			service) start_service && done+="restart " ;;
			restart) [[ $done == *" restart "* ]] || restart_service ;;
			esac
		done
		echo
		doctor --quiet && echo "$OK all good"
		return
	elif ((${#fixes[@]})); then
		echo "${DIM}run 'bfgw doctor --fix' to repair$RST"
	fi
	((fails == 0))
}

up() {
	link_files
	ensure_secrets
	install
	cli_sync
	ensure_plist
	if ! is_loaded; then
		launchctl bootstrap "gui/$UID" "$PLIST"
		echo "$OK started $LABEL"
	elif config_changed || ! healthy; then
		launchctl kickstart -k "gui/$UID/$LABEL"
		echo "$OK restarted $LABEL"
	else
		echo "$OK already running"
	fi
	wait_healthy
	doctor --quiet || true
	echo
	echo "${BOLD}dashboard${RST} $URL ${DIM}(bfgw dash)$RST"
	copy_token
}

case "${1:-}" in
"" | help | -h | --help)
	[[ -z ${1:-} ]] && status && echo
	usage
	;;
run) run ;;
up | setup) up ;;
down | stop) stop_service ;;
start) start_service ;;
restart | reload) restart_service ;;
status) status ;;
dash | open)
	copy_token
	open "$URL"
	;;
install) install "${2:-}" ;;
upgrade)
	ver="${2:-$(curl -fsS https://getbifrost.ai/latest-release | jq -r .name)}"
	install "$ver" && echo "$ver" >"$PKG_DIR/gateway.version" && restart_service
	;;
cli-sync) cli_sync ;;
logs)
	shift
	tail "$@" -n 100 "$LOG_DIR/bifrost-gateway.out.log" "$LOG_DIR/bifrost-gateway.err.log"
	;;
secret) secret "${2:?usage: bifrost-gateway secret <name>}" ;;
secrets)
	shift
	secrets_cmd "$@"
	;;
doctor)
	shift
	doctor "$@"
	;;
commands) echo "up down dash status logs doctor start stop restart secrets secret upgrade install cli-sync setup open help" ;;
*)
	usage >&2
	exit 2
	;;
esac

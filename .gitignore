# ============================================
# macOS
# ============================================
.DS_Store
.AppleDouble
.LSOverride
._*

# ============================================
# Personal/Sensitive Configuration Files
# ============================================
# Git identity files (use .example templates instead)
git/.gitconfig-personal
git/.gitconfig-work
git/.gitconfig-codeberg

# SSH keys and sensitive config
ssh/id_*
ssh/*.pem
ssh/*.key

# ============================================
# Shell History & Cache
# ============================================
**/.zcompdump
**/.zcompdump-*
**/.zsh_history
**/.bash_history
.direnv
history.txt

# ============================================
# Editor/IDE
# ============================================
# VSCode
.vscode/
*.code-workspace

# JetBrains
.idea/
*.iml

# Vim
**/.netrwhist
**/tags
**/tags.lock

# ============================================
# Plugin/Package Directories
# ============================================
tmux/plugins/
raycast/
fzf/

# Doom Emacs is cloned to ~/.config/doom-emacs by setup.sh
doom/

# Machine-local links created by the Databricks AI tools installer
claude/skills/databricks-*

# ============================================
# Build/Generated Files
# ============================================
result
*.swp
*.swo
*~

# ============================================
# Cache Directories
# ============================================
**/.cache/

# ============================================
# Opencode
# ============================================
opencode/opencode.work.jsonc

{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "anthropic/claude-opus-4-6",
  "autoupdate": true,
  "mcp": {
    "ado-mcp": {
      "type": "remote",
      "url": "https://r1ado-mcp.r1rcm.com/mcp",
      "enabled": true
    },
    "github-mcp": {
      "type": "remote",
      "url": "https://r1github-mcp.r1rcm.com/mcp",
      "enabled": true
    },
    "linear-server": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "sentry-mcp": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": true
    },
    "pagerduty-mcp": {
      "type": "remote",
      "url": "https://pagerduty-mcp.r1rcm.com/mcp",
      "enabled": true
    },
    "argocd-mcp": {
      "type": "local",
      "command": [
        "npx",
        "argocd-mcp@latest",
        "stdio"
      ],
      "environment": {
        "ARGOCD_BASE_URL": "https://argocd.sharedscf.r1rcm.com/",
        "ARGOCD_API_TOKEN": "eyJhbGciOiJSUzI1NiIsImtpZCI6IjI2MjljNDdlYWQyOWNlNDc3NTI2Njg3ODU3MGE4YjRjZDUwMDdkMDQifQ..QuFHir5WboysXTl_hgbp7BBjf2bEq9-gdIZKz3h7Q4i35J_0RnfnuxRDzTp90JGQ3IfcG1R7iPdkkpE1rN5fks7cDIQow86rHmQnVFJ2-SCi8djYr_86fsSmV8zLEX_DtULl1q7k5Smpdfj30jNlhDjS3SMe8pxZVWfO7IDvAOvqSB_sIf84y-VZsU8diHxiq7jCUbXUP0UXlzuVkJmHj4nCousnYASaHSBB4Z01Jb0_tgYUuSLkWY-UHXCrx5rSIfmebMEDPEF9coWa-gTKVEHmbEPl-yMQapA1Mm24lYj8NTh-4TZLROxKz8-sc0QN-lsRowZ0Bl0xsoTQtIbAYA"
      }
    }
  },
  "permission": {
    "tmp": {
      "/tmp/*": "allow"
    }
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "anthropic/claude-opus-5-5",
  "providers": {
    "bifrost": {
      "name": "Bifrost (local)",
      "package": "@opencode/ai/providers/anthropic-compatible",
      "env": ["BIFROST_VK_OPENCODE"],
      "settings": { "baseURL": "http://127.0.0.1:18080/anthropic/v1" },
      "models": { "claude-opus-5-5": {} }
    }
  },
  "mcp": {
    "servers": {
      "linear-server": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
      },
      "sentry-mcp": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp",
      },
      "asdste100": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "biz-dfch-asdste100mcp",
          "asdste100-mcp"
        ]
      },
      "rex-mcp": {
        "type": "remote",
        "url": "https://www.superlogical.com/rex/community-mcp",
      }

    }
  },
  "permissions": [
    {
      "action": "edit",
      "resource": "/tmp",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "/tmp/*",
      "effect": "allow"
    }
  ]
}
